{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignoreDeps": [
    "dotnet-sdk"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.CodeAnalysis.CSharp",
        "Spectre.Console"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "groupName": "test dependencies",
      "matchManagers": [
        "nuget"
      ],
      "matchFileNames": [
        "test/**"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "schedule": [
        "monthly"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "digest",
        "major",
        "patch",
        "minor",
        "pin"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    }
  ]
}
